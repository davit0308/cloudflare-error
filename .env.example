# Copy file nay thanh .env va dien gia tri that. KHONG commit .env.

# Bot Telegram de gui canh bao (tao qua @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat/group ID nhan canh bao
TELEGRAM_CHAT_ID=

# Ten mien mac dinh hien thi khi khong doc duoc header Host
TARGET_DOMAIN=tr4c3.me

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8084

# Khoa bi mat de ky/xac thuc token phien (POST vao /__client_info).
# Bat buoc dat co dinh o production, neu khong moi lan restart server
# token cu se het hieu luc va bi cham diem nghi van cao hon.
HONEYPOT_SECRET=

# Duong dan "bay" an (khong doan duoc) - nhung ai/bot theo duong link
# an nay se bi cham diem nghi van toi da. Doi gia tri nay truoc khi deploy.
HONEYTRAP_PATH=sys-panel-7f3a2c
